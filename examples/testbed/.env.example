# Test credentials of the local testbed only, never reuse them anywhere else.
# Copy-Item .env.example .env

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=unwire-testbed

# Gitea admin, created once with the command in README.md
GITEA_ADMIN_USER=unwire
GITEA_ADMIN_PASSWORD=unwire-testbed
GITEA_ADMIN_EMAIL=unwire@example.test
