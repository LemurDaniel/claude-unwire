# Test credentials of the local testbed only, never reuse them anywhere else.
# Copy-Item .env.example .env

# Mock router: test login, and the session value every login answers with
# (URL-safe, it goes into a cookie, a query, a path segment and a Bearer header)
MOCK_ROUTER_USER=admin
MOCK_ROUTER_PASSWORD=admin
MOCK_ROUTER_SESSION=admin-session
